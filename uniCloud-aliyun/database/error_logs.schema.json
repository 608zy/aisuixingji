{
  "bsonType": "object",
  "required": ["error_type", "error_message", "created_at"],
  "permission": {
    "read": false,
    "create": true,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "错误日志 ID"
    },
    "user_id": {
      "bsonType": "string",
      "description": "用户 ID（可选）",
      "foreignKey": "uni-id-users._id"
    },
    "error_type": {
      "bsonType": "string",
      "description": "错误类型",
      "title": "错误类型",
      "enum": [
        "NETWORK_TIMEOUT",
        "CLOUD_FUNCTION_ERROR",
        "AI_API_ERROR",
        "MISSING_PARAMS",
        "PERMISSION_DENIED",
        "UNKNOWN_ERROR"
      ]
    },
    "error_message": {
      "bsonType": "string",
      "description": "错误消息",
      "title": "错误消息"
    },
    "error_stack": {
      "bsonType": "string",
      "description": "错误堆栈",
      "title": "错误堆栈"
    },
    "context": {
      "bsonType": "object",
      "description": "错误上下文",
      "title": "上下文",
      "properties": {
        "page": {
          "bsonType": "string",
          "description": "页面路径"
        },
        "action": {
          "bsonType": "string",
          "description": "操作名称"
        },
        "params": {
          "bsonType": "object",
          "description": "操作参数"
        },
        "timestamp": {
          "bsonType": "number",
          "description": "时间戳"
        }
      }
    },
    "created_at": {
      "bsonType": "timestamp",
      "description": "创建时间",
      "title": "创建时间",
      "forceDefaultValue": {
        "$env": "now"
      }
    }
  }
}
